# SolarOS backend settings (written by hypervisor/install-hypervisor.sh; values here are examples).
HYPERVISOR_DRIVER=native_ubuntu
NODE_NAME=solaros
DEFAULT_BRIDGE=br0
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
JWT_SECRET=change-me-to-64-hex-characters
STORAGE_ROOT=/mnt/storage
HOST_ROOT_TARGET=root@127.0.0.1
REPO_URL=https://github.com/Legend-Services/SolarOS.git
REPO_BRANCH=solaros
