PVE_HOST=https://192.168.1.10:8006
PVE_NODE=pve
PVE_PORT=8006
PVE_TOKEN_ID=solardeck@pve!solardeck
PVE_TOKEN_SECRET=00000000-0000-0000-0000-000000000000
PVE_VERIFY_SSL=false
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
JWT_SECRET=change-me-to-a-long-random-string
STORAGE_ROOT=/mnt/storage
PVE_BRIDGE=vmbr0
# Root-only host operations run through deploy/proxmox-os-helper.sh over SSH; empty runs it locally.
HOST_SSH=root@192.168.1.10
HOST_SSH_KEY=/root/.ssh/proxmox-os-helper
SAMBA_CONF=/etc/samba/proxmox-os-shares.conf
# Self-updater source and in-app bug reporter (GITHUB_TOKEN with "issues: write"; empty = pre-filled browser link).
REPO_URL=https://github.com/Legend-Services/SolarOS.git
REPO_BRANCH=main
GITHUB_TOKEN=
